# Copy this file to .env and fill in real values before running the app.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://monetized:monetized_dev_password@localhost:5432/monetized?schema=public"

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Admin seed (dev only — created once by `prisma db seed` if it doesn't exist) ---
ADMIN_SEED_EMAIL="admin@monetized.local"
ADMIN_SEED_PASSWORD=""

# --- Storage (digital product files) -----------------------------------------
# "local" stores uploads on disk under ./storage — dev only, never use in production.
# "s3" streams to an S3-compatible bucket using the credentials below.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments ------------------------------------------------------------
# "mock" simulates a successful/failed charge locally with no external calls — dev/demo only.
# Set to "razorpay" or "stripe" and fill in the matching keys to take real payments.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- Email (campaigns + automations' "send email" action) ---------------------
# "console" logs the send and records it in EmailLog — dev/demo only, nothing is
# actually delivered. Set to "resend" and fill in the key to send for real.
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- AI growth engine (product description writer) ---------------------------
# "template" is deterministic, rule-based text — no external call, no key needed.
# Set to "anthropic" and fill in the key to generate with Claude instead.
AI_PROVIDER="template"
ANTHROPIC_API_KEY=""
