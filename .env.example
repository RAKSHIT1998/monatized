# Copy this file to .env and fill in real values before running the app.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://monetized:monetized_dev_password@localhost:5432/monetized?schema=public"

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Admin seed (dev only — created once by `prisma db seed` if it doesn't exist) ---
ADMIN_SEED_EMAIL="admin@monetized.local"
ADMIN_SEED_PASSWORD=""

# --- Storage (digital product files) -----------------------------------------
# "local" stores uploads on disk under ./storage — dev only, never use in production.
# "s3" streams to an S3-compatible bucket using the credentials below.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments ------------------------------------------------------------
# "mock" simulates a successful/failed charge locally with no external calls — dev/demo only.
# Set to "razorpay" or "stripe" and fill in the matching keys to take real payments.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
