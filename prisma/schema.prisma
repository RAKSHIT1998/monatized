// Monetized — data model, grown feature-by-feature (one migration per
// feature area — see prisma/migrations for the history).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CREATOR
}

enum PlanKey {
  FREE
  CREATOR
  PRO
  BUSINESS
}

enum ProductType {
  DIGITAL
  COURSE
  SUBSCRIPTION
  BOOKING
  PHYSICAL
  TIP
}

enum FulfillmentStatus {
  NOT_APPLICABLE // not a physical order — nothing to ship
  UNFULFILLED
  SHIPPED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  INCOMPLETE // created, first payment not yet confirmed
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  MOCK
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum AnalyticsEventType {
  STORE_VIEW
  PRODUCT_VIEW
  CHECKOUT_STARTED
  ORDER_COMPLETED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum LessonContentType {
  VIDEO
  TEXT
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum CommentAuthorType {
  CREATOR
  MEMBER
}

enum CampaignAudience {
  ALL_CUSTOMERS
  ACTIVE_SUBSCRIBERS
}

enum CampaignStatus {
  DRAFT
  SENT
}

enum EmailLogStatus {
  SENT
  FAILED
}

enum AutomationTrigger {
  ORDER_PAID
  NEW_SUBSCRIBER
  SUBSCRIPTION_CANCELLED
}

enum AutomationActionType {
  ADD_CUSTOMER_TAG
  SEND_EMAIL
}

enum CustomDomainStatus {
  PENDING
  VERIFIED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CREATOR)
  // Bumping this invalidates every previously-issued session JWT for the user
  // (used on password change / logout-everywhere) without needing a session table.
  tokenVersion Int      @default(0)
  // A hash of the reset token, never the raw value — same reasoning as a
  // password hash, so a DB leak alone can't be used to reset an account.
  // Both null once unused/consumed/expired.
  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  creatorProfile CreatorProfile?
  auditLogs      AuditLog[]
}

model Plan {
  id                String   @id @default(cuid())
  key               PlanKey  @unique
  name              String
  priceMonthlyMinor Int
  currency          String   @default("INR")
  productLimit      Int? // null = unlimited
  removesBranding   Boolean  @default(false)
  platformFeeBps    Int      @default(0) // platform fee in basis points, charged per order
  features          Json     @default("[]")
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  creatorProfiles CreatorProfile[]
}

model CreatorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  username           String   @unique
  displayName        String
  bio                String?
  avatarUrl          String?
  coverImageUrl      String?
  categories         String[] @default([]) // what they're trying to monetize, from onboarding
  socialLinks        Json     @default("{}")
  onboardingStep     Int      @default(0)
  onboardingComplete Boolean  @default(false)
  planId             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan             @relation(fields: [planId], references: [id])
  theme           StoreTheme?
  products        Product[]
  customers       Customer[]
  orders          Order[]
  coupons         Coupon[]
  subscriptions   Subscription[]
  analyticsEvents AnalyticsEvent[]
  posts           Post[]
  affiliates      Affiliate[]
  campaigns       Campaign[]
  automations     Automation[]
  customDomain    CustomDomain?
}

// One custom domain per creator. Verification proves domain ownership (a DNS
// TXT record matching verificationToken) — it does not by itself make the
// domain resolve here; that's a normal DNS CNAME/A-record step on the
// creator's end, pointed at wherever this app is deployed. See README.
model CustomDomain {
  id                String             @id @default(cuid())
  creatorProfileId  String             @unique
  domain            String             @unique
  verificationToken String             @unique
  status            CustomDomainStatus @default(PENDING)
  verifiedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
}

// A trigger→action rule. actionConfig shape depends on actionType:
// ADD_CUSTOMER_TAG -> { tag: string }, SEND_EMAIL -> { subject: string, body: string }.
// Run failures are caught and logged, never thrown — an automation must not
// be able to break the payment/subscription flow that triggered it.
model Automation {
  id               String               @id @default(cuid())
  creatorProfileId String
  trigger          AutomationTrigger
  actionType       AutomationActionType
  actionConfig     Json
  isActive         Boolean              @default(true)
  runCount         Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
}

// A one-off email blast to a chosen audience. Sending is synchronous (loops
// the audience and calls the EmailProvider directly) — fine at demo/small-list
// scale; a real production version would hand this to a background queue.
model Campaign {
  id               String           @id @default(cuid())
  creatorProfileId String
  subject          String
  body             String
  audience         CampaignAudience
  status           CampaignStatus   @default(DRAFT)
  recipientCount   Int              @default(0)
  sentAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  logs           EmailLog[]
}

// One row per email actually sent — by a Campaign or (later) an Automation's
// SEND_EMAIL action. campaignId is null for the latter.
model EmailLog {
  id         String         @id @default(cuid())
  campaignId String?
  customerId String?
  toEmail    String
  subject    String
  provider   String
  status     EmailLogStatus
  createdAt  DateTime       @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
}

// A partner who refers buyers via a tracked ?ref= link. Commission is a
// ledger only — actual payout to the affiliate is a manual, out-of-band step
// for the creator (no payout execution is implemented, same posture as not
// faking payment success elsewhere in this app).
model Affiliate {
  id               String   @id @default(cuid())
  creatorProfileId String
  name             String
  email            String
  code             String // used in ?ref=CODE links; stored uppercase
  commissionBps    Int // basis points of the order total, e.g. 1000 = 10%
  accessToken      String   @unique // bookmarkable self-service stats link
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creatorProfile CreatorProfile      @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  orders         Order[]
  referrals      AffiliateReferral[]

  @@unique([creatorProfileId, code])
}

// One commission credit per paid order — created in markOrderPaid, exactly
// like coupon redemption counting happens there.
model AffiliateReferral {
  id                    String   @id @default(cuid())
  affiliateId           String
  orderId               String   @unique
  commissionAmountMinor Int
  createdAt             DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// A creator's community feed post, gated to active subscribers when
// membersOnly is true. There's no per-tier gating — any of the creator's
// ACTIVE/PAST_DUE subscriptions grants access to all of their members-only posts.
model Post {
  id               String   @id @default(cuid())
  creatorProfileId String
  title            String
  body             String
  membersOnly      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  comments       PostComment[]
}

model PostComment {
  id         String            @id @default(cuid())
  postId     String
  authorType CommentAuthorType
  customerId String? // set when authorType is MEMBER; null for the creator's own replies
  body       String
  createdAt  DateTime          @default(now())

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
}

model StoreTheme {
  id               String   @id @default(cuid())
  creatorProfileId String   @unique
  templateKey      String   @default("minimal")
  primaryColor     String   @default("#111111")
  backgroundColor  String   @default("#ffffff")
  buttonStyle      String   @default("solid")
  layout           Json     @default("[]") // ordered link-in-bio block list
  updatedAt        DateTime @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
}

model Product {
  id                     String           @id @default(cuid())
  creatorProfileId       String
  type                   ProductType      @default(DIGITAL)
  title                  String
  slug                   String
  description            String?
  priceAmountMinor       Int
  currency               String           @default("INR")
  billingInterval        BillingInterval? // only set for SUBSCRIPTION products
  // only set for BOOKING products. All availability rules and slot math are in UTC
  // for MVP simplicity — see README "Known items" before relying on this across timezones.
  bookingDurationMinutes Int?
  // only set for PHYSICAL products. Null = unlimited stock. Decremented
  // atomically at checkout (see startCheckout) and restored if the order fails.
  // Ignored once the product has variants (see ProductVariant) — each
  // variant then owns its own stock count instead.
  stockQuantity          Int?
  // only meaningful for PHYSICAL products. Null/0 = free shipping. A flat fee
  // added on top of the price at checkout — not multiplied by an item's
  // quantity within a cart line, and never discounted by a coupon, matching
  // how shipping is excluded from the discount base below.
  shippingFeeMinor       Int?
  coverImageUrl          String?
  status                 ProductStatus    @default(DRAFT)
  position               Int              @default(0)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  creatorProfile    CreatorProfile       @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  digitalFiles      DigitalProductFile[]
  modules           CourseModule[]
  enrollments       CourseEnrollment[]
  subscriptions     Subscription[]
  orderItems        OrderItem[]
  downloadGrants    DownloadGrant[]
  analyticsEvents   AnalyticsEvent[]
  availabilityRules AvailabilityRule[]
  bookings          Booking[]
  variants          ProductVariant[]

  @@unique([creatorProfileId, slug])
}

// Lightweight product options (e.g. "Red", "Small") for PHYSICAL products —
// a single flat list, not a Shopify-style multi-axis option matrix. Shares
// the product's one price; only stock is tracked per variant.
model ProductVariant {
  id            String   @id @default(cuid())
  productId     String
  label         String
  // Null = unlimited stock, same convention as Product.stockQuantity.
  stockQuantity Int?
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, label])
}

// A weekly-recurring availability window for a BOOKING product, in UTC minutes-from-midnight.
model AvailabilityRule {
  id          String   @id @default(cuid())
  productId   String
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from UTC midnight, e.g. 540 = 09:00
  endMinute   Int
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// A single confirmed (or cancelled) slot on a BOOKING product. One Booking per
// paid Order, exactly like CourseEnrollment/Subscription — the accessToken is
// the buyer's only way back in since there's no customer login system.
model Booking {
  id          String        @id @default(cuid())
  orderId     String        @unique
  productId   String
  customerId  String
  startsAt    DateTime
  endsAt      DateTime
  status      BookingStatus @default(CONFIRMED)
  accessToken String        @unique
  createdAt   DateTime      @default(now())

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  // Enforced at the DB level so two buyers can never win the same slot, even
  // under concurrent checkout attempts — the second insert simply fails.
  @@unique([productId, startsAt])
}

model CourseModule {
  id        String   @id @default(cuid())
  productId String
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]
}

model CourseLesson {
  id          String            @id @default(cuid())
  moduleId    String
  title       String
  position    Int               @default(0)
  contentType LessonContentType @default(TEXT)
  videoUrl    String?
  textContent String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  module      CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
}

// Grants ongoing access to a purchased course via a bookmarkable link — there's
// no customer login system (checkout is guest/email-only), so this token is the
// buyer's only way back in. Long-lived by design, unlike a DownloadGrant.
model CourseEnrollment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  productId   String
  customerId  String
  accessToken String   @unique
  createdAt   DateTime @default(now())

  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id])
  customer    Customer           @relation(fields: [customerId], references: [id])
  completions LessonCompletion[]
}

model LessonCompletion {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     CourseLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model DigitalProductFile {
  id            String   @id @default(cuid())
  productId     String
  fileName      String
  storageKey    String
  fileSizeBytes Int
  mimeType      String
  createdAt     DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloadGrants DownloadGrant[]
}

model Customer {
  id               String   @id @default(cuid())
  creatorProfileId String
  email            String
  name             String?
  phone            String?
  tags             String[] @default([])
  notes            String?
  totalSpentMinor  Int      @default(0)
  ordersCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  creatorProfile    CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  orders            Order[]
  courseEnrollments CourseEnrollment[]
  subscriptions     Subscription[]
  bookings          Booking[]
  postComments      PostComment[]
  emailLogs         EmailLog[]

  @@unique([creatorProfileId, email])
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  creatorProfileId       String
  customerId             String
  couponId               String?
  affiliateId            String? // captured at checkout-start from the ?ref= cookie, see proxy.ts
  subscriptionId         String? // set for both the first charge and every renewal of a subscription
  status                 OrderStatus @default(PENDING)
  currency               String      @default("INR")
  subtotalAmountMinor    Int
  discountAmountMinor    Int         @default(0)
  // The product's shipping fee at checkout time, recorded separately from
  // subtotalAmountMinor (like discountAmountMinor) so the receipt can show
  // a real Subtotal/Shipping/Total breakdown rather than one opaque number.
  shippingFeeAmountMinor Int         @default(0)
  totalAmountMinor       Int
  platformFeeAmountMinor Int         @default(0)
  // Physical fulfillment — only meaningful when the order contains a PHYSICAL
  // item (see markOrderPaid). shippingAddress shape: { name, line1, line2?,
  // city, state, postalCode, country }.
  fulfillmentStatus      FulfillmentStatus @default(NOT_APPLICABLE)
  shippingAddress        Json?
  trackingNumber         String?
  shippedAt              DateTime?
  // Optional supporter message, collected at checkout for TIP orders only.
  buyerNote              String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  creatorProfile    CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id])
  coupon            Coupon?            @relation(fields: [couponId], references: [id])
  affiliate         Affiliate?         @relation(fields: [affiliateId], references: [id])
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id])
  items             OrderItem[]
  payment           Payment?
  downloadGrants    DownloadGrant[]
  courseEnrollment  CourseEnrollment?
  booking           Booking?
  affiliateReferral AffiliateReferral?
  analyticsEvents   AnalyticsEvent[]

  @@index([creatorProfileId, status, createdAt])
}

// The ongoing relationship for a recurring product. Each billing cycle (the
// first charge and every renewal) creates its own PAID Order — Subscription
// just tracks status/renewal date/provider IDs, so revenue reporting keeps
// working against Order without a parallel ledger.
model Subscription {
  id                     String             @id @default(cuid())
  creatorProfileId       String
  productId              String
  customerId             String
  status                 SubscriptionStatus @default(INCOMPLETE)
  provider               PaymentProvider
  providerSubscriptionId String?
  accessToken            String             @unique
  // Locked in at signup so a later price change never silently reprices an
  // existing subscriber — every cycle (first charge and renewals) bills this.
  unitAmountMinor        Int
  currency               String
  billingInterval        BillingInterval
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  orders         Order[]
}

model Coupon {
  id               String             @id @default(cuid())
  creatorProfileId String
  code             String // stored uppercase
  discountType     CouponDiscountType
  discountValue    Int // PERCENT: 1-100. FIXED: minor units.
  maxRedemptions   Int? // null = unlimited
  redemptionCount  Int                @default(0)
  expiresAt        DateTime?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([creatorProfileId, code])
}

model OrderItem {
  id                       String  @id @default(cuid())
  orderId                  String
  productId                String
  titleSnapshot            String
  priceAmountMinorSnapshot Int
  quantity                 Int     @default(1)
  variantId                String?
  // Snapshot, same posture as titleSnapshot — survives the variant being
  // renamed or deleted later.
  variantLabel             String?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  provider          PaymentProvider
  providerOrderId   String?
  providerPaymentId String?
  status            PaymentStatus   @default(CREATED)
  amountMinor       Int
  currency          String
  rawPayload        Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Secure, expiring, download-limited access to a purchased digital file.
model DownloadGrant {
  id                   String   @id @default(cuid())
  orderId              String
  productId            String
  digitalProductFileId String
  token                String   @unique
  downloadsUsed        Int      @default(0)
  downloadLimit        Int      @default(5)
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product            @relation(fields: [productId], references: [id])
  digitalProductFile DigitalProductFile @relation(fields: [digitalProductFileId], references: [id])
}

model AnalyticsEvent {
  id               String             @id @default(cuid())
  creatorProfileId String
  type             AnalyticsEventType
  productId        String?
  orderId          String?
  metadata         Json?
  createdAt        DateTime           @default(now())

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])

  @@index([creatorProfileId, type, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])
}
